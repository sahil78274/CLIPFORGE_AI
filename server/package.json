    "@ffprobe-installer/ffprobe": "^2.1.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bson": "^6.10.2",
    "bullmq": "^5.34.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
