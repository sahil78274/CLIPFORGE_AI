# =============================================================================
# CLIPFORGE AI — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env (and/or server/.env) and replace placeholder values.
# NEVER commit real secrets or API keys to version control.
# =============================================================================

# --- Runtime & Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (MongoDB / MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/clipforge_ai?directConnection=true
# In local development, if no external mongod is listening on localhost,
# ClipForge AI can start an embedded MongoDB wire-protocol server backed by server/.data
ENABLE_EMBEDDED_MONGO_FALLBACK=true

# --- Authentication & Security ---
JWT_ACCESS_SECRET=replace-with-at-least-32-char-cryptographic-random-secret-key
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-char-download-url-signing-secret

# --- Initial Admin Bootstrap (Optional — used by seed script) ---
ADMIN_BOOTSTRAP_EMAIL=admin@clipforge.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeImmediately!2026

# --- Queue, Long-Video Chunking & Background Workers ---
# Leave REDIS_URL blank in local development to use the built-in persistent local worker queue
REDIS_URL=
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=7200000
# Chunk-based processing supporting videos up to 10 hours (36,000 seconds) with constant RAM
MAX_VIDEO_DURATION_SEC=36000
VIDEO_CHUNK_DURATION_SEC=600
VIDEO_CHUNK_OVERLAP_SEC=5

# --- Storage Adapter ('local' or 's3') ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
TEMP_WORKING_DIR=./temp

# S3-Compatible Object Storage (Required only when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Python Video Processor & Media Binaries ---
PYTHON_BIN=python3
FFMPEG_PATH=
FFPROBE_PATH=
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- AI Provider ('gemini' or 'openai_compatible') ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative AI Provider (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Google OAuth 2.0 + Google Picker + Google Drive Video Import ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google-drive/oauth/callback
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-char-secret-for-aes-256-gcm-refresh-token-encryption
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3

# --- YouTube Link-to-Clips & Authorized Media Acquisition ---
# Metadata extraction (strictly separate from media acquisition):
YOUTUBE_DATA_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_OEMBED_ENDPOINT=https://www.youtube.com/oembed
# Configurable media-source adapter ('composite' | 'owner_export_dir' | 'authorized_http_provider' | 'custom_command')
YOUTUBE_MEDIA_ADAPTER=composite
YOUTUBE_AUTHORIZED_EXPORTS_DIR=./authorized_youtube_exports
YOUTUBE_MEDIA_PROVIDER_URL=
YOUTUBE_MEDIA_PROVIDER_TOKEN=
YOUTUBE_MEDIA_COMMAND_BIN=
YOUTUBE_MEDIA_COMMAND_ARGS_JSON=
ALLOW_DIRECT_MEDIA_URL_IMPORT=true

# --- Payments (Razorpay — INR) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Explicitly labelled development sandbox checkout simulator (never set to true in production)
PAYMENT_SANDBOX_SIMULATOR=true
PAYMENT_SANDBOX_SECRET=dev-only-sandbox-hmac-secret-do-not-use-in-prod
